# Copy to bridge.env and fill in. bridge.env is gitignored — never commit real values.

# TODO(artur): your read-only Postgres user against the existing gate database.
PG_DSN=postgresql://readonly_user:CHANGEME@127.0.0.1/gatedb

# TODO(artur): must return exactly one row of (state, changed_at).
STATE_QUERY=SELECT state, changed_at FROM gate_state ORDER BY changed_at DESC LIMIT 1

MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USER=bridge
MQTT_PASS=CHANGEME

# TODO(artur): the gate endpoint the bridge POSTs to.
REST_URL=http://127.0.0.1:8080/api/gate

POLL_SECONDS=1.0
