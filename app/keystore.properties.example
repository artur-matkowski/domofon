# Copy to keystore.properties (gitignored) to sign release builds.
#
# Create the upload key once:
#   keytool -genkeypair -v -keystore upload.jks -keyalg RSA -keysize 4096 \
#           -validity 10000 -alias domofon-upload
#
# Back up upload.jks somewhere durable and off this machine. With Play App Signing the
# app signing key is held by Google and can be recovered; this upload key cannot be
# re-issued without contacting Play support, and losing it means losing the ability to
# publish updates.
#
# storeFile is resolved relative to the app/ root project directory.

storeFile=upload.jks
storePassword=CHANGEME
keyAlias=domofon-upload
keyPassword=CHANGEME
