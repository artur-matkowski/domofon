<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Tapjacking guard, paired with filterTouchesWhenObscured in MainActivity. Window
         .setHideOverlayWindows() throws SecurityException without this — protectionLevel is
         "normal", so it is granted at install with no prompt and no user-visible entry. -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS"/>

    <!-- The Qt AAR's own manifest declares WRITE_EXTERNAL_STORAGE and merges it into ours.
         Nothing in this app writes to shared storage, and an unexplained storage permission
         on a published listing is a question from reviewers we have no reason to invite.
         Verify after changing Qt versions: ./gradlew :app:processReleaseMainManifest -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:node="remove"/>
    <!-- And the READ the merger *implies* from Qt's WRITE. That implication is computed
         from the library manifest, so removing WRITE alone leaves READ behind. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:node="remove"/>

    <!-- Geofencing (ch. 08). BACKGROUND is not optional: without "Allow all the time" the
         geofence registers happily and then never fires. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <application
        android:name=".DomofonApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Domofon">

        <meta-data android:name="androidx.car.app.minCarApiLevel" android:value="1"/>
        <meta-data android:name="com.google.android.gms.car.application"
                   android:resource="@xml/automotive_app_desc"/>

        <!-- configChanges: an Android Auto connect/disconnect delivers uiMode (car mode)
             and possibly density changes. Without this, Android recreates the activity —
             but the Qt runtime is one QGuiApplication per process and survives, keeping
             the car-session display metrics; the recreated QtQuickView then lays out
             against a stale devicePixelRatio and the QML renders wildly mis-scaled
             (observed: ~20% of one button after unplugging from a real car). Handling the
             changes in-place keeps the view attached, so Qt only sees a resize — its
             tested path. Side effect, accepted: rotation no longer recreates the activity
             either; nothing in onCreate depends on orientation. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="uiMode|density|screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Its own process on purpose: it kills the main one and must outlive it. See
             QtRestartActivity. excludeFromRecents + noHistory so it never shows up as a
             task the user can return to; it lives for a few milliseconds. -->
        <activity
            android:name=".QtRestartActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:process=":restart"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay"/>

        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.Domofon.Settings"/>

        <!-- IOT is the official category for "control your smart devices from the car". -->
        <service
            android:name=".ui.car.DomofonCarAppService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService"/>
                <category android:name="androidx.car.app.category.IOT"/>
            </intent-filter>
        </service>

        <!-- All three are exported="false": every one of them can move the gate, and only
             the system (or our own notification) has any business triggering them. -->
        <receiver android:name=".receivers.GateCommandReceiver" android:exported="false"/>

        <receiver android:name=".receivers.GeofenceReceiver" android:exported="false"/>

        <receiver android:name=".receivers.BootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
            </intent-filter>
        </receiver>
    </application>

</manifest>
