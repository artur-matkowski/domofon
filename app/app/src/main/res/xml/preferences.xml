<?xml version="1.0" encoding="utf-8"?>
<!--
  Every value the app used to hardcode. The android:key strings must stay in lockstep with
  the K_* constants in ConfigStore — they are the same keys, and nothing checks that at
  compile time.

  No android:defaultValue on the broker host, the coordinates or any credential: a default
  that points somewhere real is exactly what this refactor exists to remove. Structural
  defaults (topic prefixes, ports) are fine and live in DomofonConfig.Defaults.
-->
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/pref_cat_broker">

        <!-- Live connection status, filled in from GateRepository.connection. Holds no
             value, so it is never written through ConfigStore; the "status." prefix keeps
             it out of that key namespace the same way "cat." does below. Not selectable:
             it is a readout, and a row that highlights invites a tap that does nothing. -->
        <Preference
            app:key="status.connection"
            app:title="@string/pref_connection_status"
            app:selectable="false"
            app:persistent="false"/>

        <EditTextPreference
            app:key="broker.host"
            app:title="@string/pref_host"
            app:summary="@string/pref_host_summary"
            app:useSimpleSummaryProvider="true"/>

        <EditTextPreference
            app:key="broker.port"
            app:title="@string/pref_port"
            app:useSimpleSummaryProvider="true"/>

        <SwitchPreferenceCompat
            app:key="broker.tls"
            app:title="@string/pref_tls"
            app:summaryOn="@string/pref_tls_on"
            app:summaryOff="@string/pref_tls_off"/>

        <EditTextPreference
            app:key="broker.username"
            app:title="@string/pref_username"
            app:useSimpleSummaryProvider="true"/>

        <!-- Summary is supplied in code; it must never render the password itself. -->
        <EditTextPreference
            app:key="broker.password"
            app:title="@string/pref_password"/>

    </PreferenceCategory>

    <!-- The key is what lets androidx.preference persist this category's expand/collapse
         state; a collapsed category without one logs an error and forgets it was expanded.
         The "cat." prefix keeps it out of ConfigStore's key namespace — categories hold no
         value, so nothing is ever written through the data store under this key. -->
    <PreferenceCategory
        app:key="cat.topics"
        app:title="@string/pref_cat_topics"
        app:summary="@string/pref_cat_topics_summary"
        app:initialExpandedChildrenCount="0">

        <EditTextPreference
            app:key="topics.rxPrefix"
            app:title="@string/pref_rx_prefix"
            app:useSimpleSummaryProvider="true"/>

        <EditTextPreference
            app:key="topics.txPrefix"
            app:title="@string/pref_tx_prefix"
            app:useSimpleSummaryProvider="true"/>

        <EditTextPreference
            app:key="topics.availability"
            app:title="@string/pref_availability"
            app:useSimpleSummaryProvider="true"/>

        <EditTextPreference
            app:key="topics.error"
            app:title="@string/pref_error_topic"
            app:useSimpleSummaryProvider="true"/>

        <EditTextPreference
            app:key="topics.nodeId"
            app:title="@string/pref_node_id"
            app:useSimpleSummaryProvider="true"/>

        <EditTextPreference
            app:key="topics.payloadKey"
            app:title="@string/pref_payload_key"
            app:useSimpleSummaryProvider="true"/>

    </PreferenceCategory>

    <!-- QoS and keep-alive are pinned per connection (see GateRepository.active), so an
         edit here lands on the next connect — for the phone UI that is the moment you
         leave this screen; an already-open Android Auto session keeps its old values
         until it ends. The category summary says as much. -->
    <PreferenceCategory
        app:key="cat.mqtt"
        app:title="@string/pref_cat_mqtt"
        app:summary="@string/pref_cat_mqtt_summary"
        app:initialExpandedChildrenCount="0">

        <ListPreference
            app:key="mqtt.qosState"
            app:title="@string/pref_qos_state"
            app:entries="@array/qos_entries"
            app:entryValues="@array/qos_values"
            app:defaultValue="1"
            app:useSimpleSummaryProvider="true"/>

        <ListPreference
            app:key="mqtt.qosCommand"
            app:title="@string/pref_qos_command"
            app:entries="@array/qos_entries"
            app:entryValues="@array/qos_values"
            app:defaultValue="1"
            app:useSimpleSummaryProvider="true"/>

        <ListPreference
            app:key="mqtt.qosAvailability"
            app:title="@string/pref_qos_availability"
            app:entries="@array/qos_entries"
            app:entryValues="@array/qos_values"
            app:defaultValue="1"
            app:useSimpleSummaryProvider="true"/>

        <EditTextPreference
            app:key="mqtt.keepAliveSeconds"
            app:title="@string/pref_keepalive"
            app:summary="@string/pref_keepalive_summary"/>

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_home">

        <SwitchPreferenceCompat
            app:key="home.enabled"
            app:title="@string/pref_geofence"
            app:summary="@string/pref_geofence_summary"/>

        <EditTextPreference
            app:key="home.latitude"
            app:title="@string/pref_latitude"
            app:dependency="home.enabled"
            app:useSimpleSummaryProvider="true"/>

        <EditTextPreference
            app:key="home.longitude"
            app:title="@string/pref_longitude"
            app:dependency="home.enabled"
            app:useSimpleSummaryProvider="true"/>

        <EditTextPreference
            app:key="home.radiusMeters"
            app:title="@string/pref_radius"
            app:summary="@string/pref_radius_summary"
            app:dependency="home.enabled"/>

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_camera">

        <!-- Credentials go inside both URLs (scheme://user:pass@host/…), which is why there
             are no separate username/password fields and why the summaries are supplied in
             code: the simple provider would print the password on the list row.

             RTSP first, and it is the only one anybody should need: every camera speaks it,
             the user already has the address, and it authenticates itself. The snapshot URL
             below overrides it for anyone with a reason — HTTP snapshot paths are
             vendor-specific and often Digest-only, so requiring one would mean the app only
             worked for people who know their camera's firmware. See docs/04 §1. -->
        <EditTextPreference
            app:key="camera.rtspUrl"
            app:title="@string/pref_rtsp_url"/>

        <EditTextPreference
            app:key="camera.snapshotUrl"
            app:title="@string/pref_snapshot_url"/>

        <EditTextPreference
            app:key="camera.snapshotSecs"
            app:title="@string/pref_snapshot_secs"
            app:summary="@string/pref_snapshot_secs_summary"/>

        <!-- Audio comes from the RTSP stream only (the snapshot override carries none), and
             plays while a camera view is open. On by default; off silences the gate without
             unsetting the URL. See docs/04 §2. -->
        <SwitchPreferenceCompat
            app:key="camera.audioEnabled"
            app:title="@string/pref_audio"
            app:summaryOn="@string/pref_audio_on"
            app:summaryOff="@string/pref_audio_off"
            app:defaultValue="true"/>

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_security">

        <SwitchPreferenceCompat
            app:key="security.requireUnlock"
            app:title="@string/pref_require_unlock"
            app:summary="@string/pref_require_unlock_summary"
            app:defaultValue="true"/>

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_about">

        <!-- Read-only build identity. Like the connection-status row above it holds no
             value (the "about." prefix keeps it out of ConfigStore's key namespace); its
             summary is set in code from PackageInfo, so it always matches the installed
             APK and can never lag behind it. -->
        <Preference
            app:key="about.version"
            app:title="@string/pref_version"
            app:selectable="false"
            app:persistent="false"/>

    </PreferenceCategory>

</PreferenceScreen>
