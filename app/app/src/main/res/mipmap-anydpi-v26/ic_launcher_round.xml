<?xml version="1.0" encoding="utf-8"?>
<!-- Identical to ic_launcher: an adaptive icon is masked by the launcher itself, so the
     round variant differs only in which launchers ask for it. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@drawable/ic_gate_foreground"/>
    <monochrome android:drawable="@drawable/ic_gate_foreground"/>
</adaptive-icon>
