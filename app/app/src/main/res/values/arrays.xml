<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The entryValues are MQTT QoS codes as strings: ListPreference persists Strings,
         which ConfigStore reads back through the same int(...) path as the port. -->
    <string-array name="qos_entries">
        <item>0 — at most once</item>
        <item>1 — at least once (default)</item>
        <item>2 — exactly once</item>
    </string-array>
    <string-array name="qos_values">
        <item>0</item>
        <item>1</item>
        <item>2</item>
    </string-array>

    <!-- The entryValues are CameraSource names, matched case-insensitively by
         CameraSource.of(). Anything unrecognised resolves to RTSP rather than throwing, so a
         hand-edited preferences file cannot leave the camera panel permanently blank. -->
    <string-array name="camera_source_entries">
        <item>RTSP stream (default)</item>
        <item>JPEG over HTTP + separate audio</item>
    </string-array>
    <string-array name="camera_source_values">
        <item>RTSP</item>
        <item>HTTP</item>
    </string-array>
</resources>
