<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only overlay. It exports GeofenceReceiver so that

      adb shell am broadcast -a pl.bitforge.domofon.DEBUG_GEOFENCE \
        -n pl.bitforge.domofon/.geo.GeofenceReceiver

  can exercise the arrival pop-up without driving 2 km out and back. The receiver is
  android:exported="false" in the real manifest, so a release build cannot be poked this
  way — which matters, because this entry point opens the gate.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <receiver
            android:name=".geo.GeofenceReceiver"
            android:exported="true"
            tools:replace="android:exported">
            <intent-filter>
                <action android:name="pl.bitforge.domofon.DEBUG_GEOFENCE"/>
            </intent-filter>
        </receiver>
    </application>

</manifest>
